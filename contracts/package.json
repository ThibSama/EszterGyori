{
  "name": "@eszter/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate-contract-artifacts.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "verify:generated": "tsx --test tests/generated-artifacts.test.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^20.19.26",
    "tsx": "^4.21.0"
  }
}
