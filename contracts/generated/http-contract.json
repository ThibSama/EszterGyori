        },
        {
          "name": "--site-tint-navigation",
          "source": "sectionTint",
          "key": "navigation"
        },
        {
          "name": "--site-tint-hero",
          "source": "sectionTint",
          "key": "hero"
        },
        {
          "name": "--site-tint-reassurance",
          "source": "sectionTint",
