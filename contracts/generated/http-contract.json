      "auth": {
        "session": "anonymous",
        "csrf": "valid",
        "account": "enabled"
      },
      "expect": {
        "status": 400,
        "body": "errorEnvelope",
        "errorCode": "VALIDATION_FAILED"
      }
    },
    {
      "id": "auth.login.post.invalidJson",
