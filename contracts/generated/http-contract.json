        "errorCode": "VALIDATION_FAILED"
      }
    },
    {
      "id": "auth.login.post.unknownField",
      "endpoint": "/api/auth/login",
      "description": "The login body is closed: an unexpected key is rejected rather than ignored.",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "headers": {
          "content-type": "application/json"
        },
        "rawBody": "{\"email\":\"editor@example.test\",\"password\":\"correct-horse-battery\",\"role\":\"admin\"}"
