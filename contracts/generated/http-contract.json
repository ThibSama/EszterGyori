        "method": "POST",
        "path": "/api/auth/login",
        "headers": {
          "content-type": "application/json"
        },
        "rawBody": "{\"email\":\"editor@example.test\",\"password\":\"correct-horse-battery\"}"
      },
      "auth": {
        "session": "anonymous",
        "csrf": "empty",
        "account": "enabled"
      },
      "expect": {
        "status": 403,
        "body": "errorEnvelope",
        "errorCode": "CSRF_TOKEN_INVALID"
      }
