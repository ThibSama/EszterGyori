        "path": "/api/auth/login",
        "headers": {
          "content-type": "application/json"
        },
        "rawBody": "{\"email\":\"editor@example.test\",\"password\":\"not-the-password\"}"
      },
      "auth": {
        "session": "anonymous",
        "csrf": "valid",
        "account": "enabled"
      },
      "expect": {
        "status": 401,
        "body": "errorEnvelope",
        "errorCode": "INVALID_CREDENTIALS",
