        "required": [
          "id",
          "localDate",
          "kind",
          "windows",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "timezone",
    "fromDate",
    "untilDate",
    "revision",
    "weeklyRules",
    "exceptions"
  ],
  "additionalProperties": false
}
