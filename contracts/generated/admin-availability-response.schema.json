{
  "$comment": "GENERATED FILE - do not edit by hand. Run `npm run generate` in contracts/.",
  "title": "AdminAvailabilityResponse",
  "description": "The stored schedule: weekly rules and the replacing date exceptions in the requested window.",
  "x-eszter-io": "output",
  "x-eszter-contentSchemaVersion": 1,
  "x-eszter-warning": "Structural validation only. Passing this schema is necessary but NOT sufficient; see semantic-rules.json.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timezone": {
      "type": "string",
      "const": "Europe/Paris"
    },
    "fromDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "untilDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "weeklyRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "weekdayIso": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "startLocal": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "endLocal": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "foldUtcOffset": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "+01:00",
                  "+02:00"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "validFrom": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "validUntil": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "weekdayIso",
          "startLocal",
          "endLocal",
          "foldUtcOffset",
          "validFrom",
          "validUntil",
          "isActive"
        ],
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "localDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "closed",
              "open"
            ]
          },
          "windows": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startLocal": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "endLocal": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "foldUtcOffset": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "+01:00",
                        "+02:00"
