.claude/

# dependencies
**/node_modules/

# frontend build output
front/.next/
front/out/

# contract package build output
contracts/dist/

# deterministic production deployment output
/dist/

# PHP backend
php/vendor/
php/.phpunit.cache/
php/data/
php/var/
# Deploy-time copy of contracts/generated/, produced by php/bin/sync-contracts.php.
php/contracts/
# Real configuration, never committed (config.example.php is).
php/config/config.php

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files
.env*
!.env.example
!**/.env.example

# OS/editor files
.DS_Store
Thumbs.db
