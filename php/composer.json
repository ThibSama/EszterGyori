{
    "name": "eszter/api",
    "description": "PHP backend foundation for the Eszter site: front controller, contract-driven validation and atomic JSON content storage.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "opis/json-schema": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "Eszter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eszter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "lint": "@php bin/lint.php",
        "stan": "@php bin/static-analysis.php",
        "test": "phpunit",
        "contracts:check": "@php bin/sync-contracts.php --check",
        "contracts:sync": "@php bin/sync-contracts.php"
    }
}
