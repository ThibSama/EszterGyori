<?xml version="1.0"?>
<ruleset name="eszter">
  <description>PSR-12, pinned. The coding-standard half of the php:static-analysis gate.</description>

  <file>src</file>
  <file>tests</file>
  <file>bin</file>
  <file>public</file>

  <arg name="colors"/>
  <arg value="np"/>

  <rule ref="PSR12"/>

  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="120"/>
      <property name="absoluteLineLimit" value="120"/>
    </properties>
  </rule>
</ruleset>
