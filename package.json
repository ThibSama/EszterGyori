{
  "name": "eszter",
  "private": true,
  "scripts": {
    "dev": "npm --prefix front run dev",
    "build": "npm --prefix front run build",
    "lint": "npm --prefix front run lint",
    "security:dependencies": "node scripts/audit-dependencies.mjs",
    "acceptance:production": "node scripts/production-acceptance.mjs",
    "validate": "node scripts/validate.mjs",
    "package:production": "npm --prefix front run build && node scripts/build-production-artifact.mjs",
    "verify:production-artifact": "node scripts/verify-production-artifact.mjs",
    "php:serve": "node scripts/serve-php.mjs",
    "php:smoke": "node scripts/smoke-local-php.mjs",
    "php:lint": "php php/bin/lint.php",
    "php:stan": "php php/bin/static-analysis.php",
    "php:test": "php/vendor/bin/phpunit -c php/phpunit.xml.dist"
  }
}
